# ---------------------------------------------------------------------------
# OurLife environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase "publishable" / anon key (safe to expose to the browser;
# row-level security is what actually protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the site URL used for auth redirects in production
# (Vercel sets NEXT_PUBLIC_SITE_URL automatically if you add it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key (Project Settings -> API -> service_role). SERVER-ONLY —
# never expose this to the browser. Used to store/read Plaid access tokens,
# which are locked behind RLS with no client-facing policies.
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (Project Settings on https://dashboard.plaid.com/team/keys). Lets you
# link bank accounts (SoFi and most US banks) and sync transactions instead
# of uploading statements by hand. Leave blank to keep that feature hidden.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# ---------------------------------------------------------------------------
# Claude (the assistant + document parsing)
# Create a key in the Anthropic Console (console.anthropic.com -> API keys).
# Server-side only: it is never exposed to the browser.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: pin a model. Left blank, the app asks the API for the newest
# Sonnet your key can see.
ANTHROPIC_MODEL=
